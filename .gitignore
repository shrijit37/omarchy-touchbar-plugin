build/
*.node

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment/local config
.env
.env.*
!.env.example
!.env.example.*

# User's live editable config — seeded from config.blueprint.ts by install.sh
# (or by configLoader.ts's runtime fallback); never tracked so edits survive
# git pull.
linux-touchbar-control-center/config.ts

# Generated at install time by the distro installers — each copies its own
# 99-omarchy-touchbar-<distro>.rules into this canonical name.
system/99-omarchy-touchbar.rules

# Custom Layer prototype's own storage — written by config-gui, watched by
# the Touch Bar app. Separate from config.ts; never tracked.
linux-touchbar-control-center/custom-layer.json

# Test/coverage output
coverage/

# Local editor artifacts
.DS_Store
.vscode/
.idea/

# AI / agent tooling — local only, never published. These are development
# scratch, not product: they must never reach the remote, in the working tree
# or in history.
.claude/
.cursor/
.aider*
.opencode/
.codex/
.gemini/
.mcp.json
