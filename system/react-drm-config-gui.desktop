# Launches config-gui. electron isn't a standalone binary — it's the npm
# workspace's hoisted node_modules/.bin/electron run against the config-gui
# app directory, same as `npm start` would.
#
# `%h/react-drm` below is a PLACEHOLDER, NOT a Desktop Entry field code:
# %h is systemd syntax and is invalid in Exec= (desktop-file-validate
# rejects it, and launchers like Vicinae/gio won't expand it). install.sh's
# install_config_gui_launcher() substitutes the actual repo path at install
# time — same reason install_user_service() rewrites react-drm.service, the
# repo isn't always cloned to $HOME/react-drm.
#
# Manual install (only correct if the repo really is at ~/react-drm):
#   install -Dm644 system/react-drm-config-gui.desktop \
#     ~/.local/share/applications/react-drm-config-gui.desktop &&
#   sed -i "s|%h/react-drm|$HOME/react-drm|g" \
#     ~/.local/share/applications/react-drm-config-gui.desktop
[Desktop Entry]
Type=Application
Name=Touch Bar Config
Comment=Edit the touch bar's config.ts
Exec=%h/react-drm/node_modules/.bin/electron %h/react-drm/config-gui
TryExec=%h/react-drm/node_modules/electron/dist/electron
Icon=preferences-system
Terminal=false
Categories=Settings;